{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "module": "NodeNext",
    "target": "ES2023",
    "types": [
      "node"
    ],
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.js",
    "scripts/*.mjs",
    "eleventy.config.js"
  ],
  "exclude": [
    "scripts/*.test.mjs"
  ]
}
