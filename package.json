{
  "name": "waseemilyas-portfolio",
  "version": "1.0.0",
  "description": "Personal portfolio of Waseem Ilyas — static site built with Eleventy (WI-PF1).",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "eleventy",
    "serve": "eleventy --serve",
    "clean": "rm -rf _site",
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "node --test --test-concurrency=1 \"scripts/**/*.test.mjs\"",
    "check": "node scripts/check.mjs",
    "lint": "oxlint src scripts eleventy.config.js",
    "typecheck": "tsrs --noEmit"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "jsdom": "^30.1.3",
    "oxlint": "1.88.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929"
  },
  "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8"
}
